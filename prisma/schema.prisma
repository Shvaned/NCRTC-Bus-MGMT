generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

///////////////////////////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////////////////////////

enum UserRole {
  admin
  control_operator
  depot_manager
  driver
  conductor
  executive
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  P1
  P2
  P3
}

enum IncidentType {
  BREAKDOWN
  ACCIDENT
  COMPLAINT
  PANIC
  OTHER
}

enum VehicleStatus {
  active
  inactive
  maintenance
  decommissioned
}

enum DutyStatus {
  DRAFT
  PUBLISHED
  ACKNOWLEDGED
  COMPLETED
  MISSED
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  info
  warning
  alert
  success
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  view
  export
}

///////////////////////////////////////////////////////////////////////////////
// CORE SaaS TABLES
///////////////////////////////////////////////////////////////////////////////

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  logoUrl     String?  @db.VarChar(500)
  settings    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users  User[]
  depots Depot[]
  duties Duty[]
  notices Notice[]

  @@map("organization")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  role           UserRole  @default(driver)
  username       String    @unique @db.VarChar(100)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  employeeId    String?   @unique @map("employee_id") @db.VarChar(50)
  depotId        String?   @map("depot_id") @db.Uuid
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  depot        Depot?        @relation(fields: [depotId], references: [id])
  sessions     UserSession[]
  auditLogs    AuditLog[]
  leaveRequests LeaveRequest[]

  @@index([organizationId])
  @@index([depotId])
  @@index([role])
  @@map("user")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  group       String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo   String?   @map("device_info") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_session")
}

model AuditLog {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  action       AuditAction
  entity       String     @db.VarChar(100)
  entityId     String?    @map("entity_id") @db.VarChar(100)
  details      Json?      @db.JsonB
  ipAddress    String?    @map("ip_address") @db.VarChar(45)
  userAgent    String?    @map("user_agent") @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model FileUpload {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  fileName    String    @map("file_name") @db.VarChar(500)
  fileSize    Int       @map("file_size")
  mimeType    String    @map("mime_type") @db.VarChar(100)
  url         String    @db.VarChar(1000)
  entityType  String?   @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("file_upload")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  type            NotificationType @default(info)
  title           String           @db.VarChar(255)
  message         String           @db.Text
  isRead          Boolean          @default(false) @map("is_read")
  actionUrl       String?          @map("action_url") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")
  readAt          DateTime?        @map("read_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notification")
}

///////////////////////////////////////////////////////////////////////////////
// FLEET TABLES
///////////////////////////////////////////////////////////////////////////////

model Depot {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  code           String    @unique @db.VarChar(20)
  address        String?   @db.Text
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  location       Unsupported("geometry(Point, 4326)")?
  contactPhone   String?   @map("contact_phone") @db.VarChar(20)
  capacity       Int?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  vehicles     Vehicle[]
  duties       Duty[]
  routes       Route[]
  incidents    Incident[]

  @@map("depot")
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  depotId          String        @map("depot_id") @db.Uuid
  registrationNumber String      @unique @map("registration_number") @db.VarChar(50)
  vehicleType      String        @map("vehicle_type") @db.VarChar(50)
  make             String?       @db.VarChar(100)
  model            String?       @db.VarChar(100)
  year             Int?
  capacity         Int?
  status           VehicleStatus @default(active)
  deviceId         String?       @unique @map("device_id") @db.VarChar(100)
  currentLatitude  Decimal?      @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude Decimal?      @map("current_longitude") @db.Decimal(10, 7)
  lastPingAt       DateTime?     @map("last_ping_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  depot          Depot              @relation(fields: [depotId], references: [id])
  liveState      VehicleLiveState?
  gpsPings       GpsPing[]
  tripSessions   TripGpsSession[]
  geofenceEvents GeofenceEvent[]
  incidents      Incident[]

  @@index([organizationId])
  @@index([depotId])
  @@index([status])
  @@map("vehicle")
}

model VehicleLiveState {
  id          String            @id @default(uuid()) @db.Uuid
  vehicleId   String            @unique @map("vehicle_id") @db.Uuid
  driverId    String?           @map("driver_id") @db.Uuid
  routeId     String?           @map("route_id") @db.Uuid
  status      VehicleLiveStatus @default(OFFLINE)
  speed       Decimal?          @db.Decimal(8, 2)
  heading     Decimal?          @db.Decimal(6, 2)
  ignition    Boolean?
  odometer    Int?
  fuelLevel   Decimal?          @map("fuel_level") @db.Decimal(5, 2)
  temperature Decimal?          @db.Decimal(5, 2)
  tripStatus  String?           @map("trip_status") @db.VarChar(50)
  lastPingAt  DateTime?         @map("last_ping_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([driverId])
  @@map("vehicle_live_state")
}

model Stop {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  code           String?   @unique @db.VarChar(50)
  address        String?   @db.Text
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  location       Unsupported("geometry(Point, 4326)")?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  routeStops RouteStop[]

  @@index([organizationId])
  @@map("stop")
}

model Route {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  depotId        String?     @map("depot_id") @db.Uuid
  name           String      @db.VarChar(255)
  code           String      @unique @db.VarChar(50)
  origin         String?     @db.VarChar(255)
  destination    String?     @db.VarChar(255)
  distanceKm     Decimal?    @map("distance_km") @db.Decimal(8, 2)
  estimatedTimeMin Int?      @map("estimated_time_min")
  status         RouteStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  depot      Depot?      @relation(fields: [depotId], references: [id])
  routeStops RouteStop[]
  duties     Duty[]

  @@index([organizationId])
  @@index([depotId])
  @@index([status])
  @@map("route")
}

model RouteStop {
  id          String @id @default(uuid()) @db.Uuid
  routeId     String @map("route_id") @db.Uuid
  stopId      String @map("stop_id") @db.Uuid
  sequence    Int
  arrivalMin  Int?   @map("arrival_min")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@map("route_stop")
}

///////////////////////////////////////////////////////////////////////////////
// SCHEDULING TABLES
///////////////////////////////////////////////////////////////////////////////

model Duty {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  depotId        String     @map("depot_id") @db.Uuid
  driverId       String?    @map("driver_id") @db.Uuid
  conductorId    String?    @map("conductor_id") @db.Uuid
  vehicleId      String?    @map("vehicle_id") @db.Uuid
  routeId        String?    @map("route_id") @db.Uuid
  date           DateTime   @db.Date
  startTime      DateTime   @map("start_time")
  endTime        DateTime   @map("end_time")
  status         DutyStatus @default(DRAFT)
  publishedAt    DateTime?  @map("published_at")
  ackAt          DateTime?  @map("ack_at")
  notes          String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  depot        Depot        @relation(fields: [depotId], references: [id])
  route        Route?       @relation(fields: [routeId], references: [id])

  @@index([date, depotId])
  @@index([driverId])
  @@index([conductorId])
  @@index([vehicleId])
  @@index([status, depotId])
  @@map("duty")
}

model LeaveRequest {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  startDate DateTime    @map("start_date") @db.Date
  endDate   DateTime    @map("end_date") @db.Date
  reason    String      @db.Text
  status    LeaveStatus @default(pending)
  reviewedBy String?    @map("reviewed_by") @db.Uuid
  notes     String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("leave_request")
}

///////////////////////////////////////////////////////////////////////////////
// AVLS TABLES
///////////////////////////////////////////////////////////////////////////////

enum VehicleLiveStatus {
  ACTIVE
  IDLE
  OFFLINE
  MAINTENANCE
  OFF_ROUTE
}

model GpsPing {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  location   Unsupported("geometry(Point, 4326)")?
  speed      Decimal? @db.Decimal(8, 2)
  heading    Decimal? @db.Decimal(6, 2)
  accuracy   Decimal? @db.Decimal(8, 2)
  ignition   Boolean?
  ts         DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, ts(sort: Desc)])
  @@index([ts])
  @@map("gps_ping")
}

model TripGpsSession {
  id            String    @id @default(uuid()) @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  routeId       String?   @map("route_id") @db.Uuid
  dutyId        String?   @map("duty_id") @db.Uuid
  sessionStatus String    @default("ACTIVE") @map("session_status") @db.VarChar(20)
  startTime     DateTime  @map("start_time")
  endTime       DateTime? @map("end_time")
  distanceKm    Decimal?  @map("distance_km") @db.Decimal(10, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([dutyId])
  @@index([sessionStatus])
  @@map("trip_gps_session")
}

model GeofenceEvent {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  geofenceId String   @map("geofence_id") @db.VarChar(100)
  eventType  String   @map("event_type") @db.VarChar(50)
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  ts         DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, ts])
  @@map("geofence_event")
}

///////////////////////////////////////////////////////////////////////////////
// IMS TABLES
///////////////////////////////////////////////////////////////////////////////

model Incident {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  depotId        String?         @map("depot_id") @db.Uuid
  vehicleId      String?         @map("vehicle_id") @db.Uuid
  reportedById   String          @map("reported_by_id") @db.Uuid
  assignedToId   String?         @map("assigned_to_id") @db.Uuid
  type           IncidentType    @default(OTHER)
  title          String          @db.VarChar(500)
  description    String?         @db.Text
  status         IncidentStatus  @default(OPEN)
  severity       IncidentSeverity @default(P2)
  latitude       Decimal?        @db.Decimal(10, 7)
  longitude      Decimal?        @db.Decimal(10, 7)
  resolvedAt     DateTime?       @map("resolved_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id])
  depot            Depot?   @relation(fields: [depotId], references: [id])
  events            IncidentEvent[]
  attachments       IncidentAttachment[]
  assignmentHistory IncidentAssignmentHistory[]

  @@index([status, depotId])
  @@index([vehicleId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([organizationId])
  @@index([severity])
  @@index([type])
  @@map("incident")
}

model IncidentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(50)
  fromStatus String?  @map("from_status") @db.VarChar(50)
  toStatus   String?  @map("to_status") @db.VarChar(50)
  note       String?  @db.Text
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_event")
}

model IncidentAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(500)
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  url        String   @db.VarChar(1000)
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_attachment")
}

model IncidentAssignmentHistory {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  assignedTo  String   @map("assigned_to") @db.Uuid
  assignedBy  String   @map("assigned_by") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  notes       String?  @db.Text

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_assignment_history")
}

///////////////////////////////////////////////////////////////////////////////
// CMS TABLES
///////////////////////////////////////////////////////////////////////////////

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Notice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  title          String       @db.VarChar(500)
  content        String       @db.Text
  status         NoticeStatus @default(DRAFT)
  audienceJson   Json?        @map("audience_json") @db.JsonB
  requiresAck    Boolean      @default(false) @map("requires_ack")
  publishedAt    DateTime?    @map("published_at")
  archivedAt     DateTime?    @map("archived_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  reads        NoticeRead[]

  @@index([organizationId])
  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@map("notice")
}

model NoticeRead {
  id             String    @id @default(uuid()) @db.Uuid
  noticeId       String    @map("notice_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  readAt         DateTime? @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId])
  @@index([noticeId, readAt])
  @@map("notice_read")
}
