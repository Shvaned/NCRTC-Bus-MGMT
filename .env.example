# Environment Variables
# Copy this file to .env and fill in the values

# Database (Neon PostgreSQL)
# 1. Create a free project at https://neon.tech
# 2. In Dashboard, copy the connection string (not pooled)
# 3. Paste below — must end with ?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR-PASSWORD@ep-xxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth
NEXTAUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="change-me-to-a-different-random-string-at-least-32-chars"

# App
NODE_ENV="development"
LOG_LEVEL="debug"
